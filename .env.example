# Govee: request in the Govee Home app -> My Profile -> Settings -> Apply for API Key
GOVEE_API_KEY=

# Qingping: register at https://developer.qingping.co -> click your email (top right) -> Access Management
QINGPING_APP_KEY=
QINGPING_APP_SECRET=

# Optional: Govee app account login. Enables live power/voltage/current for
# energy-monitoring plugs (H5086) via Govee's private IoT channel (unofficial).
GOVEE_EMAIL=
GOVEE_PASSWORD=

# Optional tuning
PORT=8088
# Interface to bind. 0.0.0.0 = reachable from other devices on your network,
# 127.0.0.1 = this machine only. Never expose either to the internet.
HOST=0.0.0.0
# Optional shared secret. When set, the /setup save + test endpoints require
# it. Leave blank on a trusted home network; set it if others share the LAN.
SETTINGS_TOKEN=
GOVEE_IOT_POLL_SECONDS=60
GOVEE_POLL_SECONDS=120
QINGPING_POLL_SECONDS=300
QINGPING_BACKFILL_DAYS=7

# Electricity rates for the energy cost calculation ($/kWh). Peak window is
# PEAK_START_HOUR..PEAK_END_HOUR (local time) EVERY day, weekends included
# (PG&E E-TOU-C3 prices weekends the same); everything else is off-peak.
# These defaults are all-in marginal rates (PG&E delivery + CleanPowerSF
# generation), summer season.
PEAK_RATE_PER_KWH=0.6061
OFFPEAK_RATE_PER_KWH=0.4348
PEAK_START_HOUR=16
PEAK_END_HOUR=21
